// Neon Saloon - Prisma 7 Schema (no datasource block)

generator client {
  provider = "prisma-client-js"
}

// ─── Lobby / Session ─────────────────────────────────────────────────────────

/// A live game session identified by a 4-digit PIN
model GameSession {
  id        String        @id @default(cuid())
  pin       String        @unique // e.g. "7342"
  status    SessionStatus @default(WAITING)
  hostName  String        @default("Host")

  currentCardIndex Int @default(0)
  cardRevealedAt   DateTime?

  teams   Team[]
  players Player[]
  votes   Vote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SessionStatus {
  WAITING  // Lobby - players joining
  ACTIVE   // Game in progress
  REVEAL   // Votes being shown
  FINISHED // Game over
}

// ─── Team ────────────────────────────────────────────────────────────────────

/// A team within a session (a solo player is treated as a team-of-one)
model Team {
  id    String @id @default(cuid())
  name  String
  color String @default("#FF10F0")
  score Int    @default(0)
  emoji String @default("🤠")

  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  players Player[]
  votes   Vote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, name])
}

// ─── Player ──────────────────────────────────────────────────────────────────

/// An individual player within a session
model Player {
  id     String @id @default(cuid())
  name   String
  avatar String @default("🤠")

  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId String?

  votes Vote[]

  joinedAt DateTime @default(now())

  @@unique([sessionId, name])
}

// ─── Vote ─────────────────────────────────────────────────────────────────────

/// A single player's answer/vote for one card/question
model Vote {
  id          String @id @default(cuid())
  cardIndex   Int
  answerIndex Int    // 0-3 for MCQ, -1 for "completed", -2 for "failed"
  answerText  String @default("")

  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId String?

  castAt DateTime @default(now())

  @@unique([sessionId, playerId, cardIndex])
}

// ─── Content ─────────────────────────────────────────────────────────────────

/// A trivia question (can be linked to a session as custom content)
model Question {
  id         String   @id @default(cuid())
  text       String
  answer     String
  options    String[] // array of 2-4 answer choices
  category   String   @default("bride-trivia")
  difficulty Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// A physical/social challenge card
model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String   // 'action' | 'charades' | 'dare'
  points      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
