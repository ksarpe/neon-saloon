generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  password       String?
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  isPremium                Boolean   @default(false)
  //STRIPE
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripeCurrentPeriodEnd   DateTime?
  stripeSubscriptionStatus String?

  neverQuestions      NeverQuestion[]
  quizQuestions       QuizQuestion[]
  passwordResetTokens PasswordResetToken[]
  gameSettings        GameSettings?
  purchaseConsents    PurchaseConsent[]

  @@index([email])
  @@index([stripeCustomerId])
}

// Rejestr zgód konsumenta na rozpoczęcie świadczenia przed terminem odstąpienia.
// Tworzony przy każdej próbie zakupu (ślad dowodowy: data, plan, treść, IP, urządzenie).
model PurchaseConsent {
  id        String @id @default(cuid())
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  plan      String
  version   String
  text      String
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model GameSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  revealCountdownSeconds Int @default(4)
  answerTimeLimitSeconds Int @default(120)
  brTimerSeconds         Int @default(20)
  brAutoNextSeconds      Int @default(10)

  updatedAt DateTime @updatedAt
}

model NeverQuestion {
  id   String @id @default(cuid())
  text String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@index([userId])
}

model QuizQuestion {
  id      String   @id @default(cuid())
  text    String
  answer  String
  options String[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
