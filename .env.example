NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Password reset emails
# Without these values, reset links are returned only in development responses/logs.
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="Last Rodeo <verification@aknsoftware.com>"

# Optional, recommended in production: shared rate-limit store.
# Without this, the app falls back to in-memory per-process limits.
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
RATE_LIMIT_KEY_PREFIX=neon-saloon
