NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Password reset emails
# Without these values, reset links are returned only in development responses/logs.
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="Last Rodeo <verification@aknsoftware.com>"

# Required in production: shared rate-limit store.
# Local development falls back to in-memory per-process limits.
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
RATE_LIMIT_KEY_PREFIX=neon-saloon

# Required in production for bot protection on registration and anonymous lobby creation.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key
BOT_PROTECTION_REQUIRED=true
